# =============================================================================
#         Makefile for AccessControlSystem (root directory output)
# =============================================================================

# 1. КОМПИЛЯТОР И ФЛАГИ
# -----------------------------------------------------------------------------
CXX = g++
CXXFLAGS = -std=c++17 -g -Wall -Wextra -Isrc


# 2. ДИРЕКТОРИИ И ФАЙЛЫ
# -----------------------------------------------------------------------------
# Директория для временных объектных файлов
OBJ_DIR = obj

# Имя финального исполняемого файла (без пути)
TARGET = app

# Автоматический поиск всех .cpp файлов
SRCS := $(wildcard src/*.cpp \
                   src/cli/*.cpp \
                   src/core/*.cpp \
                   src/utils/*.cpp \
                   src/infrastructure/*.cpp \
                   src/auth/*.cpp \
                   src/services/*.cpp)

# Генерация списка объектных файлов (.o) на основе исходных (.cpp)
OBJS = $(patsubst %.cpp, $(OBJ_DIR)/%.o, $(notdir $(SRCS)))

# VPATH для поиска исходных кодов в поддиректориях src/
VPATH = $(sort $(dir $(SRCS)))


# 3. ПРАВИЛА СБОРКИ
# -----------------------------------------------------------------------------

# Правило по умолчанию
all: $(TARGET)

# Правило для компоновки (линковки): создание исполняемого файла в корне.
# Зависимость от директории `bin` убрана.
$(TARGET): $(OBJS)
	@echo "Linking executable: $@"
	$(CXX) $^ -o $@

# Правило для компиляции: создание объектного файла (.o) из файла исходного кода (.cpp).
# Зависит от существования директории obj.
$(OBJ_DIR)/%.o: %.cpp | $(OBJ_DIR)
	@echo "Compiling: $< -> $@"
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Правило для создания директории obj, если она не существует.
$(OBJ_DIR):
	@mkdir -p $@


# 4. ВСПОМОГАТЕЛЬНЫЕ ПРАВИЛА
# -----------------------------------------------------------------------------

# Правило для очистки.
# Теперь оно удаляет директорию `obj` и исполняемый файл `app` из корня.
clean:
	@echo "Cleaning up..."
	@rm -rf $(OBJ_DIR) $(TARGET)

# Правило для запуска.
# Путь к исполняемому файлу теперь `./app`, что соответствует новому `TARGET`.
run: all
	@echo "Running application..."
	./$(TARGET)

# Объявление "фальшивых" целей.
.PHONY: all clean run